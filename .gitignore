# =========================
# OS / System files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.env/
.venv/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Data: ignore contents, keep folders
# =========================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

*.nii
*.nii.gz
*.npy
*.npz

# =========================
# Models: ignore contents, keep folder
# =========================
models/*
!models/.gitkeep

*.pth
*.pt
*.ckpt

# =========================
# Outputs / Logs: ignore contents, keep folders
# =========================
outputs/figures/*
outputs/metrics/*
outputs/explainability/*
logs/*

!outputs/figures/.gitkeep
!outputs/metrics/.gitkeep
!outputs/explainability/.gitkeep
!logs/.gitkeep

*.log
*.out
*.err

# =========================
# Optional: ignore generated figures globally
# =========================
*.png
*.jpg
*.jpeg

# =========================
# VS Code / IDE
# =========================
.vscode/
.idea/

# =========================
# Temporary / cache
# =========================
*.tmp
*.cache

# =========================
# Archives
# =========================
*.zip
*.tar
*.gz